# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/urlshortener?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600

# Background Jobs
CLEANUP_INTERVAL_MS=60000

# Rate Limiting — General API guard (all /api/* routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Rate Limiting — Login (5 attempts / IP / 15 min)
LOGIN_RATE_LIMIT=5
LOGIN_WINDOW_MS=900000

# Rate Limiting — Registration (5 accounts / IP / 1 hour)
REGISTER_RATE_LIMIT=5
REGISTER_WINDOW_MS=3600000

# Rate Limiting — URL creation (100 URLs / authenticated user / 1 hour)
URL_RATE_LIMIT=100
URL_WINDOW_MS=3600000

# Rate Limiting — Redirect (1000 requests / IP / 1 minute)
REDIRECT_RATE_LIMIT=3
REDIRECT_WINDOW_MS=60000
